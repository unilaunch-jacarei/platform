# SQLite e o padrão local: não requer servidor de banco de dados.
DATABASE_URL=sqlite+aiosqlite:///platform.db
# Para desenvolver com PostgreSQL, substitua pela URL abaixo:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/platform

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=dev-secret-platform-jwt-key-minimum-32-chars-long!
JWT_LIFETIME_SECONDS=604800
RATE_LIMIT_STORAGE_URI=memory://
METRICS_TOKEN=
LEAD_RETENTION_DAYS=365

# Porta e endereço do Backend FastAPI
BIND_ADDR=0.0.0.0:8000

# URL pública do Frontend
PUBLIC_APP_URL=http://localhost:5173

# SMTP obrigatório em produção para recuperação de senha
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contato@example.com
SMTP_STARTTLS=true
